{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated schema for the cabo counter game data",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "createdAt": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "players": {
        "type": "array",
        "minItems": 2,
        "maxItems": 5,
        "items": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "gameSessionId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "position": {
                "type": "integer"
              },
              "totalScore": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "gameSessionId",
              "name",
              "position",
              "totalScore"
            ],
            "additionalProperties": false,
          }
        ]
      },
      "pointLimit": {
        "type": ["integer", "null"]
      },
      "caboPenalty": {
        "type": "integer"
      },
      "isGameFinished": {
        "type": "boolean"
      },
      "roundList": {
        "type": "array",
        "items": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "gameSessionId": {
                "type": "string"
              },
              "caboPlayerIndex": {
                "type": "integer"
              },
              "kamikazePlayerIndex": {
                "type": "null"
              },
              "scores": {
                "type": "array",
                "items": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "scoreUpdates": {
                "type": "array",
                "items": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ]
              }
            },
            "required": [
              "id",
              "gameSessionId",
              "caboPlayerIndex",
              "kamikazePlayerIndex",
              "scores",
              "scoreUpdates"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "required": [
      "id",
      "createdAt",
      "title",
      "players",
      "pointLimit",
      "caboPenalty",
      "isGameFinished",
      "roundList"
    ],
    "additionalProperties": false
  }
}